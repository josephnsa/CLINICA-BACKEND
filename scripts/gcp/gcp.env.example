# =============================================================
# gcp.env.example
# Copia este archivo como "gcp.env" y rellena los valores reales
# NUNCA subas gcp.env a GitHub (está en .gitignore)
# =============================================================

# ── Proyecto GCP ─────────────────────────────────────────────
PROJECT_ID="pe-axelior-clinapp-dev"
REGION="us-central1"

# ── Supabase ─────────────────────────────────────────────────
# application-prod usa el Transaction Pooler en puerto 6543 (recomendado para Cloud Run).
# DB_PORT ya no se usa en el JDBC de prod; no uses 5432 desde serverless (límite bajo de sesiones).
#
# Si en Cloud Run ves: FATAL: Tenant or user not found
#  → El pooler no reconoce DB_USER / host. Copia EXACTO desde Supabase:
#    Dashboard → Project Settings → Database → "Connection string"
#    → Modo "Transaction pooler" (puerto 6543).
#    DB_USER debe ser postgres.<PROJECT_REF> (ej. postgres.abcdefghijklmnop), no solo "postgres".
#    DB_HOST debe ser el hostname del pooler que muestra Supabase (puede variar por región/proyecto).
#    DB_PASSWORD es la contraseña de la base de datos (Database password), no la service role API key.
DB_HOST="aws-1-sa-east-1.pooler.supabase.com"
DB_NAME="postgres"
# Sustituye REEMPLAZA_PROJECT_REF por los ~20 chars del ref (Settings → General → Reference ID)
DB_USER="postgres.REEMPLAZA_PROJECT_REF"
DB_PASSWORD="CAMBIA_ESTO_POR_TU_PASSWORD_SUPABASE"

# Client ID OAuth (Web) de GCP — mismo valor que en el frontend
GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"

# ── JWT ──────────────────────────────────────────────────────
# Secret en Secret Manager (versión latest). Debe tener >= 32 bytes en UTF-8
# (HS256). Recomendado: openssl rand -hex 32  →  64 caracteres hex
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRET_DE_64_CHARS_MINIMO"

# ── Artifact Registry ────────────────────────────────────────
AR_REPO="clinica-backend"
IMAGE_NAME="salud-backend"
IMAGE_TAG="v1.0.0"

# ── Cloud Run ────────────────────────────────────────────────
SERVICE_NAME="salud-backend"
SA_NAME="clinica-backend-sa"

# ── CORS ─────────────────────────────────────────────────────
# URL exacta del frontend (sin trailing slash).
# Para Firebase Hosting usa web.app/firebaseapp.com y luego tu dominio final.
CORS_ALLOWED_ORIGINS="https://pe-axelior-clinapp-dev.web.app,https://pe-axelior-clinapp-dev.firebaseapp.com,https://subdominio.axelior.ai"

# ── API Gateway (03_setup_gateway.sh) ────────────────────────
# Nombres lógicos de los recursos del gateway (se crean una sola vez).
API_NAME="clinica-salud-api"
GATEWAY_NAME="clinica-gateway"
GATEWAY_CONFIG_ID="v1"
