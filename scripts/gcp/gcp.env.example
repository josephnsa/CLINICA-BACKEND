# =============================================================
# gcp.env.example
# Copia este archivo como "gcp.env" y rellena los valores reales
# NUNCA subas gcp.env a GitHub (está en .gitignore)
# =============================================================

# ── Proyecto GCP ─────────────────────────────────────────────
PROJECT_ID="pe-axelior-clinapp-dev"
REGION="us-central1"

# ── Supabase ─────────────────────────────────────────────────
# application-prod usa el Transaction Pooler en puerto 6543 (recomendado para Cloud Run).
# DB_PORT ya no se usa en el JDBC de prod; no uses 5432 desde serverless (límite bajo de sesiones).
DB_HOST="aws-1-sa-east-1.pooler.supabase.com"
DB_NAME="postgres"
DB_USER="postgres.TU_PROJECT_REF"
DB_PASSWORD="CAMBIA_ESTO_POR_TU_PASSWORD_SUPABASE"

# Client ID OAuth (Web) de GCP — mismo valor que en el frontend
GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"

# ── JWT ──────────────────────────────────────────────────────
# Secret en Secret Manager (versión latest). Debe tener >= 32 bytes en UTF-8
# (HS256). Recomendado: openssl rand -hex 32  →  64 caracteres hex
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRET_DE_64_CHARS_MINIMO"

# ── Artifact Registry ────────────────────────────────────────
AR_REPO="clinica-backend"
IMAGE_NAME="salud-backend"
IMAGE_TAG="v1.0.0"

# ── Cloud Run ────────────────────────────────────────────────
SERVICE_NAME="salud-backend"
SA_NAME="clinica-backend-sa"

# ── CORS ─────────────────────────────────────────────────────
# URL exacta del frontend (sin trailing slash)
CORS_ALLOWED_ORIGINS="https://tu-frontend.com"
