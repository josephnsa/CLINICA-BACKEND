#!/usr/bin/env bash
# Variables base para provisionar LB + IAP delante de Cloud Run.

PROJECT_ID="pe-axelior-clinapp-dev"
PROJECT_NUMBER="1073061395882"
REGION="us-central1"

# Servicio Cloud Run objetivo (BFF recomendado)
RUN_SERVICE="salud-backend-bff"

# Naming de recursos de LB
NEG_NAME="salud-bff-neg"
BACKEND_SERVICE_NAME="salud-bff-backend"
URL_MAP_NAME="salud-bff-url-map"
HTTPS_PROXY_NAME="salud-bff-https-proxy"
FORWARDING_RULE_NAME="salud-bff-https-fr"
SSL_CERT_NAME="salud-bff-managed-cert"

# Dominio que apuntará al LB (si aún no hay DNS, deja placeholder y completa luego)
LB_HOSTNAME="api.axelior.ai"

# Dominio/grupo autorizado en IAP
IAP_MEMBER="domain:axelior.ai"
# Opcional: group:equipo@axelior.ai

# OAuth brand/client para IAP (si no existen, se crean)
IAP_SUPPORT_EMAIL="anthony.luyo@axelior.ai"
IAP_APP_TITLE="Salud Backend BFF"
